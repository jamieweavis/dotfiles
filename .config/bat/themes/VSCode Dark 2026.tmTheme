			<key>scope</key>
			<string>variable.other.member, variable.other.property, variable.other.object.property, meta.object-literal.key, support.variable.property, entity.name.label</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79c0ff</string>
			</dict>

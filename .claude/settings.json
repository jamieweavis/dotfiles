{
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm check)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format)",
      "Bash(pnpm info:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm list:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm view *)"
    ],
    "deny": [
      "Edit(.env*)",
      "Read(.env*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": true,
  "terminalProgressBarEnabled": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false
}

		<dict>
			<key>name</key>
			<string>Macro, preprocessor</string>
			<key>scope</key>
			<string>entity.name.function.macro, support.function.macro, keyword.control.import, keyword.control.directive, meta.preprocessor, punctuation.definition.directive</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff7b72</string>

		<!-- Variables -->
		<dict>
			<key>name</key>
			<string>Variable</string>
			<key>scope</key>
			<string>variable, variable.other, variable.other.readwrite, entity.name.variable</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffa657</string>

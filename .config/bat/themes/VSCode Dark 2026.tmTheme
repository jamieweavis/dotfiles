<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Editor colours come from Microsoft's "2026 Dark" default theme
	https://github.com/microsoft/vscode/blob/main/extensions/theme-defaults/themes/2026-dark.json
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>VSCode Dark 2026</string>
	<key>uuid</key>
	<string>b7a4c1e2-2026-4d3a-9f5b-1c0e8a7d6f42</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>semanticClass</key>
	<string>theme.dark.vscode_dark_2026</string>
	<key>settings</key>
	<array>

		<!-- Editor defaults -->
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#121314</string>
				<key>foreground</key>
				<string>#bbbebf</string>
				<key>caret</key>
				<string>#bbbebf</string>
				<key>lineHighlight</key>
				<string>#242526</string>
				<key>selection</key>
				<string>#276782</string>
				<key>selectionForeground</key>
				<string>#ededed</string>
				<key>findHighlight</key>
				<string>#276782</string>
				<key>findHighlightForeground</key>
				<string>#ededed</string>
				<key>gutter</key>
				<string>#121314</string>
				<key>gutterForeground</key>
				<string>#858889</string>
				<key>invisibles</key>
				<string>#8c8c8c</string>
				<key>guide</key>
				<string>#2a2b2c</string>
				<key>activeGuide</key>
				<string>#838485</string>
				<key>stackGuide</key>
				<string>#333536</string>
				<key>bracketsForeground</key>
				<string>#bfbfbf</string>
				<key>bracketContentsForeground</key>
				<string>#bfbfbf</string>
				<key>tagsForeground</key>
				<string>#7ee787</string>
			</dict>
		</dict>

		<!-- Comments -->
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string>italic</string>
				<key>foreground</key>
				<string>#8b949e</string>
			</dict>
		</dict>

		<!-- Keywords, storage, control flow -->
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, keyword.control, keyword.operator.expression, keyword.operator.new, keyword.operator.logical, storage, storage.type, storage.modifier</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff7b72</string>
			</dict>
		</dict>

		<!-- Plain operators and punctuation -->
		<dict>
			<key>name</key>
			<string>Operator, punctuation</string>
			<key>scope</key>
			<string>keyword.operator, punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor, punctuation.definition.parameters, meta.brace, meta.delimiter</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#bfbfbf</string>
			</dict>
		</dict>

		<!-- Strings -->
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string, string.quoted, string.template, punctuation.definition.string, meta.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#a5d6ff</string>
			</dict>
		</dict>

		<!-- Regular expressions -->
		<dict>
			<key>name</key>
			<string>Regexp</string>
			<key>scope</key>
			<string>string.regexp, string.regexp punctuation.definition.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#a5d6ff</string>
			</dict>
		</dict>

		<!-- Escapes -->
		<dict>
			<key>name</key>
			<string>Escape sequence</string>
			<key>scope</key>
			<string>constant.character.escape, constant.other.placeholder, string.regexp keyword.other</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string>bold</string>
				<key>foreground</key>
				<string>#7ee787</string>
			</dict>
		</dict>

		<!-- Numbers, booleans, language constants -->
		<dict>
			<key>name</key>
			<string>Constant</string>
			<key>scope</key>
			<string>constant, constant.numeric, constant.language, constant.other, support.constant, variable.language, variable.other.constant</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79c0ff</string>
			</dict>
		</dict>

		<!-- Character literals -->
		<dict>
			<key>name</key>
			<string>Character</string>
			<key>scope</key>
			<string>constant.character</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff7b72</string>
			</dict>
		</dict>

		<!-- Functions and methods -->
		<dict>
			<key>name</key>
			<string>Function</string>
			<key>scope</key>
			<string>entity.name.function, meta.function-call entity.name.function, meta.function-call variable.function, support.function, variable.function, meta.require, entity.other.attribute-name.decorator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#d2a8ff</string>
			</dict>

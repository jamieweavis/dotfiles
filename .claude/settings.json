{
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm check)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format)",
      "Bash(pnpm info:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm list:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm view *)"
    ],
    "deny": [
      "Edit(.env*)",
      "Read(.env*)",
      "Write(.env*)"
    ]
  },
  "prefersReducedMotion": true,
  "skipAutoPermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "terminalProgressBarEnabled": false,
  "theme": "dark-ansi",
  "useAutoModeDuringPlan": false
}

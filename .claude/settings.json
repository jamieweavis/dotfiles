{
  "permissions": {
  "defaultMode": "manual",
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm check)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format)",
      "Bash(pnpm info:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm list:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm view *)"
    ],
    "deny": [
      "Edit(.env*)",
      "Read(.env*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-mode-cache-heal.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": true,
  "terminalProgressBarEnabled": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false
}
